# Copier ce fichier en .env puis adapter les valeurs
APP_NAME=TicketGo
APP_ENV=development
APP_URL=http://localhost:8000

# Base de données (SQLite par défaut, fichier créé par database/init.php)
DB_DSN=sqlite:storage/ticketgo.sqlite

# Délai minimum (en heures) avant le départ pour pouvoir annuler un billet
CANCEL_LIMIT_HOURS=2
